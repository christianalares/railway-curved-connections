{
  "manifest_version": 3,
  "name": "Railway Curved Connections",
  "version": "0.7.0",
  "description": "Makes Railway architecture connections easier to follow with curved routes and source dots.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://railway.com/project/*"],
      "js": ["content-bundle.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Railway Curved Connections",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
